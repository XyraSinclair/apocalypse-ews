[Unit]
Description=Apocalypse EWS self-healing history repair
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=xyra
WorkingDirectory=/opt/dev/apocalypse-ews
EnvironmentFile=/etc/apocalypse-ews.env
Environment=NODE_ENV=production
Environment=PATH=/opt/dev/apocalypse-ews/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/node scripts/repair_history_gaps.js
NoNewPrivileges=true
